# === 资金写入/撮合开关（严格默认关闭；只有完成全部验收后才允许显式开启）===
# 运行时代码仅在变量值精确等于 '1' 时启用；未设置、空值或其他值均保持关闭。
# 在隔离 PostgreSQL 迁移、买卖双方账本核对、并发/幂等/回滚、精度/手续费和端到端验收全部通过前，必须保持为 0。
FINANCIAL_POSTGRES_RPC_ENABLED=0
FINANCIAL_POSTGRES_FULL_CUTOVER_APPROVED=0
FINANCIAL_POSTGRES_READS_ENABLED=0
FINANCIAL_MATCHING_ENGINE_ENABLED=0

# === 运行环境（默认 production；本地开发必须显式设置 CONTEXT=dev）===
# CONTEXT=dev 时才会把 localhost 加入 CORS 白名单并允许 mock 登录等开发特性。
CONTEXT=production

# === CORS 允许来源（逗号分隔）===
# 生产环境仅允许生产域名。本地开发地址仅在 CONTEXT=dev 时由代码自动追加，无需在此配置。
CORS_ALLOWED_ORIGINS=https://btcboxcdt.vercel.app

# === Supabase（必填项）===
SUPABASE_URL=https://your-project.supabase.co
# 填入 Service-role Key（服务端专用，绝不可暴露给前端；旧密钥建议先在 Supabase 端轮换停用）
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_AUTH_URL=https://your-project.supabase.co
# 公开可用于前端的 Publishable/Anon key（格式必须以 sb_publishable_ 或 eyJ 开头，不含空格/换行）
SUPABASE_AUTH_PUBLISHABLE_KEY=sb_publishable_your_publishable_key
SUPABASE_AUTH_ANON_KEY=sb_publishable_your_publishable_key

# === 充值地址（仅从环境变量读取，fail-closed：缺失或格式不匹配时该币种显示"维护中"，绝不回退硬编码地址）===
# 共 6 个真实地址槽位（USDT-ERC20 与 ETH/USDC 同地址，USDT-BEP20 可选）。上线前务必由运营确认链归属与地址有效性。
# 地址格式校验：0x 开头必须是 EVM 链（ETH/ERC20/BEP20）；base58 必须是 SOL/TRX/BTC。
DEPOSIT_USDT_TRC20=your_usdt_trc20_deposit_address          # TRON 链，T 开头 base58
DEPOSIT_USDT_ERC20=your_evm_deposit_address                 # EVM 链 0x 开头（与 ETH/USDC 同地址）
DEPOSIT_USDT_BEP20=                                         # 可选，BSC 链 0x 开头
DEPOSIT_BTC=your_btc_taproot_deposit_address                # BTC Taproot（bc1p...）或 Legacy/P2SH
DEPOSIT_ETH=your_evm_deposit_address                        # EVM 链 0x 开头（与 USDT-ERC20/USDC 同地址）
DEPOSIT_SOL=your_sol_deposit_address                        # Solana base58。⚠️ 链归属请运营确认：用户提供的 EC2dRbTBaNG... 标注为 SOLO，变量名沿用 DEPOSIT_SOL
DEPOSIT_BNB=your_bnb_bep20_deposit_address                  # BSC 链 0x 开头。⚠️ 链归属请运营确认：用户提供的 0x4273171b... 标注为 BNA，变量名沿用 DEPOSIT_BNB
DEPOSIT_USDC_ERC20=your_evm_deposit_address                 # EVM 链 0x 开头（与 ETH 同地址）

# === 提现安全阈值（可选，不设置则使用代码默认值）===
# 大额提现触发人工审核的 USDT 等值门槛（默认 1000）
WITHDRAWAL_LARGE_THRESHOLD_USDT=1000
# 新绑定提现地址的冷却期（小时，默认 24）
WITHDRAWAL_ADDRESS_COOLDOWN_HOURS=24

# === server.py / Vercel 管理后台（生产部署前务必设置强账号密码）===
# ADMIN_PASS 强度要求：≥12 位，必须含大小写字母+数字+符号；弱密码拒绝启动。
ADMIN_USER=
ADMIN_PASS=

# === 模拟谷歌登录（仅本地开发演示用）===
# 硬限制：仅当 CONTEXT=dev 且 ALLOW_GOOGLE_MOCK=1 同时满足时可用；生产路径不可达。
ALLOW_GOOGLE_MOCK=0
